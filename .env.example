# --- Agent LLM ---------------------------------------------------------------
# LLM_PROVIDER defaults to "litellm"; set "openai" to use the direct
# OpenAI-compatible client instead.
LLM_PROVIDER=litellm
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here
# Optional: point at any OpenAI-compatible gateway (OpenAI, Azure, local, etc.).
# Leave unset to use the provider default (https://api.openai.com/v1).
# LLM_BASE_URL=https://api.openai.com/v1
# Gateway example (use a model ID returned by <base-url>/models):
# LLM_BASE_URL=https://your-gateway.example.com/v1
# LLM_MODEL=gpt-5-mini
# LLM_API_KEY=your-gateway-key

# --- User simulator LLM (model defaults to gpt-5-mini) ------------------------
# Provider defaults to litellm. Credentials and base URL inherit from LLM_*
# when their USER_LLM_* overrides are unset.
# USER_LLM_PROVIDER=litellm
# USER_LLM_MODEL=gpt-5-mini
# USER_LLM_API_KEY=sk-your-api-key-here
# USER_LLM_BASE_URL=https://api.openai.com/v1
# Gateway example (the key and URL inherit from LLM_* when omitted; set these
# explicitly when the user simulator has separate settings):
# USER_LLM_API_KEY=your-gateway-key
# USER_LLM_BASE_URL=https://your-gateway.example.com/v1
# USER_LLM_REASONING_EFFORT=low

# --- Semantic response judge -------------------------------------------------
# Used only by tasks with `expected_response_semantic`. The shared defaults for
# the executor, user simulator, and judge live in benchmark/benchmark.yaml.
# These environment variables override that file; keep overrides fixed across
# compared runs.
# JUDGE_LLM_PROVIDER=litellm
# JUDGE_LLM_MODEL=gpt-5-mini
# JUDGE_LLM_API_KEY=sk-your-api-key-here
# JUDGE_LLM_BASE_URL=https://api.openai.com/v1

# --- Engine ------------------------------------------------------------------
# USE_BURR=1 (default) runs the Apache Burr state-machine ReAct engine.
# USE_BURR=0 runs the plain-Python ReAct loop. Both are vendor-runtime-free.
# USE_BURR=1
# TEMPERATURE=0.0
# Per-completion token budget for the agent under test (default 16384).
# Lower this to cap spend, or raise it further for models that spend part of
# the budget on reasoning/thinking output, which can otherwise hit
# "max_tokens or model output limit reached" errors.
# LLM_MAX_TOKENS=16384

# --- User simulation strategy ------------------------------------------------
# How the simulated user replies: "react" (default, LLM ReAct loop), "llm"
# (single-shot LLM), or "human" (you type each turn at the console).
# USER_STRATEGY=react
# USER_MAX_TOKENS=1086
# USER_MAX_MESSAGE_CHARS=4000

# --- Timeouts ----------------------------------------------------------------
# Conversation turn cap (default 30).
# MAX_TURNS=30
# Per-request timeout for the OpenAI-compatible client, in seconds (default 120).
# A hung socket read is aborted after this so the retry loop can fire.
# OPENAI_REQUEST_TIMEOUT=120
# Per-request timeout handed to LiteLLM, in seconds (default 120).
# LITELLM_REQUEST_TIMEOUT=120
# Wall-clock budget for a single benchmark task, in seconds (default 1200).
# When reached the task is stopped between turns and recorded as timed out.
# TASK_TIMEOUT=1200
# Separate per-step budgets keep simulator stalls distinguishable from agent stalls.
# AGENT_STEP_TIMEOUT=240
# USER_STEP_TIMEOUT=90

# --- Retries / rate limiting -------------------------------------------------
# Bounded automatic retries on transient connection/timeout errors.
#   OpenAI client: fixed at 3 attempts (5s/10s/20s backoff).
#   LiteLLM client: configurable, default 2 (0 disables).
# LITELLM_NUM_RETRIES=2
# Client-side requests-per-minute cap shared across all clients (0 = unlimited).
# LLM_RPM=0

# --- Reasoning / provider knobs ----------------------------------------------
# Agent thinking budget for reasoning-capable models: "disable", "low",
# "medium", or "high".
# LLM_REASONING_EFFORT=low
# Let LiteLLM silently drop params a provider rejects (e.g. temperature on some
# Bedrock models) instead of erroring. Off by default.
# LITELLM_DROP_PARAMS=false
# Send LiteLLM's anonymous usage telemetry. Off by default; opt in explicitly.
# LITELLM_TELEMETRY=false

# --- TLS (debug only) --------------------------------------------------------
# SSL_VERIFY=false disables TLS certificate verification PROCESS-WIDE for every
# request. Use ONLY against a trusted local proxy with a self-signed cert; never
# against a public endpoint. Left at "true" for any real run.
# SSL_VERIFY=true
